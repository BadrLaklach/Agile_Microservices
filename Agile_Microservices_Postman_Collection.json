{
  "info": {
    "name": "Agile Microservices Ecosystem",
    "description": "Comprehensive API collection for the Agile Microservices project covering Auth, Projects, Sprints, Tasks, and Metrics. All requests route through the API Gateway (port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "replace-with-project-uuid",
      "type": "string"
    },
    {
      "key": "sprint_id",
      "value": "replace-with-sprint-uuid",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "replace-with-task-uuid",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "replace-with-user-uuid",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User Service (Auth & Identity)",
      "item": [
        {
          "name": "Register User (PO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Fatima\",\n  \"lastName\": \"Manager\",\n  \"email\": \"fatima.manager@example.com\",\n  \"password\": \"SecurePassword123\",\n  \"role\": \"PO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register User (DEV)",
          "request": {
