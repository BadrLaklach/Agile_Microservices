            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Tariq\",\n  \"lastName\": \"Developer\",\n  \"email\": \"tariq.dev@example.com\",\n  \"password\": \"SecurePassword123\",\n  \"role\": \"DEV\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
