      "item": [
        {
          "name": "1. Register Fatima (Product Owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Fatima\",\n  \"lastName\": \"Manager\",\n  \"email\": \"fatima.manager@example.com\",\n  \"password\": \"SecurePassword123\",\n  \"role\": \"PO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "2. Register Tariq (Developer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
